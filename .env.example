# Copy this file to .env and fill in the real values.
# .env must never be committed (see .gitignore).

# postgres
# locally with Docker: postgresql://cars:cars@localhost:5432/cars
DATABASE_URL=postgresql://cars:cars@localhost:5432/cars

# Cloudflare R2, where the photos live
# find these at https://dash.cloudflare.com/?to=/:account/r2
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_key_here
R2_BUCKET=cars-photos
# the public URL Cloudflare gives the bucket, e.g. https://pub-xxx.r2.dev
R2_PUBLIC_URL=

# where photos are kept on disk, before or alongside R2
PHOTOS_DIR=./photos

# proxy, optional
# format: http://user:pass@host:port  or  socks5://host:port
PROXY_URL=

# parser tuning
# how many cars to scrape at the same time
CONCURRENT_PAGES=10
# how many times to retry a car page that fails to load
RETRY_PER_CAR=2
# how long to wait for a page before giving up
PAGE_TIMEOUT_MS=25000

# exchange rates, optional
# used to convert prices to USD for sorting and filtering. Rates move, so you can
# update them here instead of touching the code. Leave blank for the defaults
# (EUR 1.08, GEL 0.37).
FX_EUR_USD=1.08
FX_GEL_USD=0.37

# search rate limits, optional (see render.yaml / rate_limit.py)
# minimum seconds between searches, per browser token
SEARCH_COOLDOWN_SECONDS=10
# hourly limit per token; <= 0 turns it off and leaves only the cooldown
SEARCH_LIMIT_PER_HOUR=0
# hourly ceiling per IP, the backstop against scraping
SEARCH_LIMIT_PER_IP_HOUR=3000
