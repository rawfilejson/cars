# ===================================================================
# გარემოს ცვლადები — დააკოპირე ეს ფაილი .env-ად და ჩაწერე რეალური მნიშვნელობები
# .env ფაილი არასოდეს არ უნდა შევიდეს git-ში (იხ. .gitignore)
# ===================================================================

# --- PostgreSQL ბაზა ---
# ლოკალურად Docker-ით: postgresql://cars:cars@localhost:5432/cars
DATABASE_URL=postgresql://cars:cars@localhost:5432/cars

# --- Cloudflare R2 (ფოტოების სათავსო) ---
# იხილე: https://dash.cloudflare.com/?to=/:account/r2
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_key_here
R2_BUCKET=cars-photos
# Public URL, რომელიც Cloudflare-მა მოგცა (მაგ: https://pub-xxx.r2.dev)
R2_PUBLIC_URL=

# --- ფოტოების ლოკალური საქაღალდე (R2-მდე ან/და გვერდით) ---
PHOTOS_DIR=./photos

# --- პროქსი (არასავალდებულო) ---
# ფორმატი: http://user:pass@host:port  ან  socks5://host:port
PROXY_URL=

# --- პარსერის პარამეტრები ---
# რამდენი მანქანა ერთდროულად scrape-დება
CONCURRENT_PAGES=10
# რამდენი მცდელობა თუ ერთი მანქანის გვერდი ვერ ჩაიტვირთა
RETRY_PER_CAR=2
# რამდენი წამის ლოდინი ერთი მცდელობის შემდეგ
PAGE_TIMEOUT_MS=25000
